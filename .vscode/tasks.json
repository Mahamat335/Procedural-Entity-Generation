{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "-I${workspaceFolder}/Libraries/include",
                "-I${workspaceFolder}/Libraries/include/imgui",
                "-I${workspaceFolder}/Header Files",
                "-I${workspaceFolder}/resources",
                "${workspaceFolder}/src/*.cpp",
                "${workspaceFolder}/src/Shapes/*.cpp",
                "${workspaceFolder}/src/imgui/*.cpp",
                "${workspaceFolder}/src/*.c",
                "-lGL",
                "-lglfw",
                "-o",
                "${workspaceFolder}/cutable.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}